{
  "version": 8,
  "name": "videre-offline-basemap",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///tiles/basemap.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "detail": {
      "type": "vector",
      "url": "pmtiles:///tiles/detail.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#aadaff"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f2efe9"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#eeece5",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "filter": ["in", ["get", "kind"], ["literal", ["forest", "grassland", "scrub"]]],
      "paint": {
        "fill-color": "#c8e6c9",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#aadaff"
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#b0b0b0",
        "line-opacity": 0.8,
        "line-width": 0.9
      }
    },
    {
      "id": "detail-water",
      "type": "fill",
      "source": "detail",
      "source-layer": "water",
      "paint": {
        "fill-color": "#aadaff"
      }
    },
    {
      "id": "detail-park",
      "type": "fill",
      "source": "detail",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "forest",
            "wood",
            "grass",
            "garden",
            "cemetery"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#c8e6c9",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "detail-buildings",
      "type": "fill",
      "source": "detail",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dedad3",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "detail-roads-minor",
      "type": "line",
      "source": "detail",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "minor_road",
            "other"
          ]
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          16,
          5
        ]
      }
    },
    {
      "id": "detail-roads-major",
      "type": "line",
      "source": "detail",
      "source-layer": "roads",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "major_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#fff3c4",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          9,
          0.6,
          16,
          8
        ]
      }
    },
    {
      "id": "detail-roads-highway",
      "type": "line",
      "source": "detail",
      "source-layer": "roads",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "highway"
          ]
        ]
      ],
      "paint": {
        "line-color": "#f7c97e",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          9,
          1,
          16,
          10
        ]
      }
    },
    {
      "id": "detail-road-names",
      "type": "symbol",
      "source": "detail",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "has",
        "name"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#52525b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "detail-place-names",
      "type": "symbol",
      "source": "detail",
      "source-layer": "places",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "neighbourhood",
            "macrohood",
            "locality"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#3f3f46",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ],
  "glyphs": "/fonts/{fontstack}/{range}.pbf"
}
